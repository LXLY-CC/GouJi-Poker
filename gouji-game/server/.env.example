# Gouji game server config. Copy to .env (never commit a real .env).
PORT=8787
# Community base URL (with /forum subdirectory if any). Leave empty for dev mode.
COMMUNITY_ISSUER=
# Application ID from the community app page.
APP_ID=01900000-0000-7000-8000-000000000000
# Public origin of this server (the audience in the platform JWT).
SERVER_ORIGIN=https://api.example.com
# CHANNEL=production | sandbox
CHANNEL=production
# DEV_MODE=1 accepts unauthenticated local connections (default when no issuer).
DEV_MODE=1
